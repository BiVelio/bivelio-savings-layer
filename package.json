{
  "name": "@bivelio/savings-layer",
  "version": "1.0.0",
  "description": "The savings layer for your LLM bill: a zero-dependency open-core layer inside your code — and a local gateway for coding agents — that lets through only what has to be paid for, and returns a SavingsReport per call measured with your provider's own meter. Apache-2.0, zero telemetry by default; the optional cloud adds team dashboard and shared caches.",
  "keywords": [
    "llm",
    "cost-optimization",
    "llm-costs",
    "token-accounting",
    "observability",
    "bivelio"
  ],
  "homepage": "https://savings.bivelio.com",
  "bugs": {
    "email": "support@bivelio.com",
    "url": "https://savings.bivelio.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiVelio/bivelio-savings-layer.git"
  },
  "license": "Apache-2.0",
  "author": "BiVelio Inc.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "import": "./dist/adapters/ai-sdk.js",
      "default": "./dist/adapters/ai-sdk.js"
    },
    "./mastra": {
      "types": "./dist/adapters/mastra.d.ts",
      "import": "./dist/adapters/mastra.js",
      "default": "./dist/adapters/mastra.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js",
      "default": "./dist/adapters/langchain.js"
    },
    "./anthropic-sdk": {
      "types": "./dist/adapters/anthropic-sdk.d.ts",
      "import": "./dist/adapters/anthropic-sdk.js",
      "default": "./dist/adapters/anthropic-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bvsala": "./dist/gateway/bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/terminales",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-CLOUD.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "build:packages": "pnpm -r --filter=./packages/* build",
    "build:services": "pnpm -r --filter=./services/* build",
    "build:all": "pnpm run build && pnpm run build:packages && pnpm run build:services",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm -r --filter=./packages/* --filter=./services/* typecheck",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:packages && pnpm run typecheck:ejemplos",
    "typecheck:ejemplos": "tsc -p examples/stacks/tsconfig.json",
    "paper:contenido": "tsx scripts/paper.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "example:basic": "BVSALA_DEV_OPEN=1 tsx examples/basic/index.ts",
    "example:handoff": "BVSALA_DEV_OPEN=1 tsx examples/multi-agent/handoff.ts",
    "example:serialization": "BVSALA_DEV_OPEN=1 tsx examples/serialization/format-selector.ts",
    "example:otel": "BVSALA_DEV_OPEN=1 tsx examples/exporters/otel.ts",
    "example:focus": "BVSALA_DEV_OPEN=1 tsx examples/exporters/focus.ts",
    "example:nextjs": "BVSALA_DEV_OPEN=1 tsx examples/stacks/nextjs/run.ts",
    "example:express": "BVSALA_DEV_OPEN=1 tsx examples/stacks/express/server.ts",
    "example:ai-sdk": "BVSALA_DEV_OPEN=1 tsx examples/stacks/ai-sdk/bivelio-check.ts",
    "example:mastra": "BVSALA_DEV_OPEN=1 tsx examples/stacks/mastra/bivelio-check.ts",
    "example:langchain": "BVSALA_DEV_OPEN=1 tsx examples/stacks/langchain/bivelio-check.ts",
    "example:anthropic-sdk": "BVSALA_DEV_OPEN=1 tsx examples/stacks/anthropic-sdk/bivelio-check.ts",
    "example:litellm": "BVSALA_DEV_OPEN=1 tsx examples/litellm/check.ts",
    "init:ejemplos": "tsx scripts/ejemplos-de-init.ts",
    "paridad:vectores": "tsx scripts/paridad-vectores.ts",
    "example:licensed": "tsx examples/licensing/licensed.ts",
    "license:demo": "tsx examples/licensing/demo.ts",
    "example:revocation": "tsx examples/licensing/revocation.ts",
    "demo:e2e": "tsx examples/licensing/e2e.ts",
    "demo:install": "bash examples/licensing/install-demo.sh",
    "demo": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/run.ts",
    "ablation": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/ablation.ts",
    "ab": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/ab-live.ts",
    "fidelidad": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/fidelidad-elision.ts",
    "web:build": "tsup",
    "web:dev": "node apps/web/serve.mjs",
    "prepublishOnly": "pnpm run build",
    "ab:publish": "tsx benchmarks/publish.ts",
    "bench:mt-bench": "tsx --env-file-if-exists=.env.bench benchmarks/publicados/mt-bench/mt-bench.ts",
    "ab:sonda": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/sonda-del-banco.ts",
    "medicion:reproducir": "node apps/web/public/measure/reproduce.mjs",
    "verja:calibrar": "tsx corpus/calibrar-la-verja.ts",
    "corpus:arnes": "tsx corpus/arnes/informe.ts",
    "corpus:auditar": "tsx corpus/auditoria/auditar.ts",
    "sombra:corpus": "tsx benchmarks/sombra-corpus.ts",
    "ttl:replay": "tsx benchmarks/ttl/replay.ts",
    "compactacion:banco": "tsx benchmarks/compactacion-de-cola/banco.ts",
    "ahorro:banco": "tsx benchmarks/ahorro-tool-results/banco.ts",
    "dedup:banco": "tsx benchmarks/dedup-de-lote.ts",
    "sombra:diales": "tsx --env-file-if-exists=.env.bench benchmarks/sombra-diales.ts",
    "anillo1": "tsx --env-file-if-exists=.env.bench benchmarks/anillo1/arnes.ts",
    "anillo2": "tsx benchmarks/anillo2/arnes.ts",
    "anillo2:conciliar": "tsx benchmarks/anillo2/conciliar.ts",
    "anillo2:fugas": "zsh scripts/anillo2-vigia-fugas.zsh",
    "salida": "tsx --env-file-if-exists=.env.bench benchmarks/salida/arnes.ts",
    "salida:anatomia": "tsx benchmarks/salida/anatomia.ts",
    "salida:por-clase": "tsx benchmarks/salida/por-clase.ts",
    "esfuerzo": "tsx --env-file-if-exists=.env.bench benchmarks/esfuerzo/banco.ts",
    "luz-verde": "bash scripts/luz-verde.sh",
    "sonda:sdk": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/sdk/sonda.ts",
    "sbom:tarball": "tsx scripts/sbom.ts",
    "rc:verify": "pnpm run build:all && pnpm exec tsx scripts/release-candidate.ts",
    "cache-semantica": "BVSALA_DEV_OPEN=1 tsx benchmarks/cache-semantica/arnes.ts",
    "cache-semantica:publicar": "tsx benchmarks/cache-semantica/publicar.ts",
    "latencia:gateways": "tsx benchmarks/latencia-gateways/arnes.ts",
    "vigia:conexiones": "tsx benchmarks/latencia-gateways/vigia-conexiones.ts",
    "litellm:e2e": "tsx benchmarks/delante-de-litellm/e2e.ts",
    "catalogo:contraste": "tsx scripts/contraste-catalogo.ts",
    "cache-semantica:calibrada": "BVSALA_DEV_OPEN=1 tsx benchmarks/cache-semantica/calibrada.ts",
    "cache-semantica:simulacion": "tsx benchmarks/cache-semantica/simulacion.ts",
    "bench:postgres-semantica": "tsx packages/persistence-postgres/benchmark/semantic-100k.ts",
    "bench:bfcl": "tsx --env-file-if-exists=.env.bench benchmarks/publicados/bfcl/arnes.ts",
    "bench:gsm8k": "tsx --env-file-if-exists=.env.bench benchmarks/publicados/gsm8k/arnes.ts",
    "bench:xstest": "tsx --env-file-if-exists=.env.bench benchmarks/publicados/xstest/banco.ts",
    "banco:semanal": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/banco-semanal/orquestador.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/openai": "4.0.78",
    "@anthropic-ai/sdk": "0.128.0",
    "@langchain/core": "1.2.13",
    "@langchain/openai": "1.6.0",
    "@mastra/core": "1.71.0",
    "@noble/curves": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "ai": "7.0.118",
    "ai-v6": "npm:ai@6.0.293",
    "express": "5.2.1",
    "gpt-tokenizer": "^3.4.0",
    "hyparquet": "^1.31.2",
    "langchain": "1.5.14",
    "pg": "^8.23.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "zod": "4.6.6"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "zod": "4.6.6",
      "undici": "7.30.1",
      "hono": "4.13.14",
      "langsmith": "0.11.1",
      "vite": "6.4.4",
      "vitest": "4.1.12",
      "esbuild": "0.28.1",
      "tinypool": "2.1.2",
      "source-map-js": "1.2.2",
      "nanoid": "3.3.20",
      "postcss": "8.5.23",
      "body-parser": "2.4.0"
    }
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.103.0 <1",
    "@langchain/core": ">=1.1.0 <2",
    "@mastra/core": ">=1.68.0 <2",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^6.0.0 || ^7.0.0",
    "gpt-tokenizer": "^3",
    "langchain": ">=1.1.0 <2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "gpt-tokenizer": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "langchain": {
      "optional": true
    }
  }
}
