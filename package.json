{
  "name": "@bivelio/savings-layer",
  "version": "0.2.3",
  "description": "BV-SALA — provider-neutral LLM execution optimizer. A decision layer in front of any LLM provider that cuts the cost of every request while preserving required quality, and reports the saving per call with token-level accounting you can check against your bill. Proprietary and confidential — property of BiVelio Inc.",
  "keywords": [
    "llm",
    "cost-optimization",
    "llm-costs",
    "token-accounting",
    "observability",
    "bivelio"
  ],
  "homepage": "https://savings.bivelio.com",
  "repository": {
    "type": "git",
    "url": "https://savings.bivelio.com"
  },
  "bugs": {
    "email": "support@bivelio.com",
    "url": "https://savings.bivelio.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "BiVelio Inc.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:packages": "pnpm -r --filter=./packages/* build",
    "build:services": "pnpm -r --filter=./services/* build",
    "build:all": "pnpm run build:packages && pnpm run build:services && pnpm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm -r --filter=./packages/* --filter=./services/* typecheck",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "example:basic": "BVSALA_DEV_OPEN=1 tsx examples/basic/index.ts",
    "example:handoff": "BVSALA_DEV_OPEN=1 tsx examples/multi-agent/handoff.ts",
    "example:serialization": "BVSALA_DEV_OPEN=1 tsx examples/serialization/format-selector.ts",
    "example:licensed": "tsx examples/licensing/licensed.ts",
    "license:demo": "tsx examples/licensing/demo.ts",
    "example:revocation": "tsx examples/licensing/revocation.ts",
    "demo:e2e": "tsx examples/licensing/e2e.ts",
    "demo:install": "bash examples/licensing/install-demo.sh",
    "demo": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/run.ts",
    "ablation": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/ablation.ts",
    "ab": "BVSALA_DEV_OPEN=1 tsx --env-file-if-exists=.env.bench benchmarks/ab-live.ts",
    "web:build": "tsup",
    "web:dev": "node apps/web/serve.mjs",
    "prepublishOnly": "pnpm run build",
    "ab:publish": "tsx benchmarks/publish.ts"
  },
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "@types/node": "^22.10.2",
    "gpt-tokenizer": "^3.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.17.1",
  "peerDependencies": {
    "gpt-tokenizer": "^3"
  },
  "peerDependenciesMeta": {
    "gpt-tokenizer": {
      "optional": true
    }
  }
}
