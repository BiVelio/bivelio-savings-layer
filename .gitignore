node_modules/
dist/
coverage/
*.log
.DS_Store
.env
.env.*
# Los ficheros de EJEMPLO sí van al repositorio: documentan los NOMBRES de las
# variables (nunca un valor) y son lo único que le dice a quien clona esto qué
# hay que aprovisionar. La excepción era solo `.env.example`, así que
# `apps/web/.env.local.example` y `.env.bench.example` llevaban desde siempre
# fuera de git sin que nadie lo notara: dos veces se documentó ahí una variable
# nueva (CRON_SECRET entre ellas) creyendo que quedaba registrada, y no salía del
# portátil de quien la escribió.
!.env.example
!*.example
.turbo/
.vitest/
*.tsbuildinfo
benchmarks/out/
.claude/

# Vercel CLI project link (local)
.vercel/

# license signing private keys — never commit
keys/*.key.pem
keys/*.private.pem

# Supabase CLI link artifacts at the repo root only (NOT apps/web/lib/supabase)
/supabase/

# Credenciales del benchmark LIVE (pnpm ab). NUNCA se versiona.
.env.bench
# Artefactos de build de Next: nunca se versionan.
.next/
apps/web/.next/

# Notas locales de trabajo (grep de entorno, citas): nunca se versionan.
/entorno.txt
/docs-citas.txt

# local research and analysis scratch space
_research/
