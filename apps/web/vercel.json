{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "diag/xstest-351-apertura": false
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/dunning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/invariantes",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cierre-extractos",
      "schedule": "0 5 1 * *"
    },
    {
      "path": "/api/cron/facturar-extractos",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/cobrar-asientos",
      "schedule": "30 7 1 * *"
    },
    {
      "path": "/api/cron/retencion",
      "schedule": "45 3 * * *"
    }
  ]
}
