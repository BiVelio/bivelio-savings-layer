# Supabase — la identidad de plataforma que YA existe en BiVelio.
#
# Se reutiliza el MISMO proyecto que el resto de la suite para que un cliente
# tenga UNA sola cuenta BiVelio — no se crea un proyecto nuevo ni una anon key
# nueva. Cuál es exactamente ese proyecto lo dice el valor que hay puesto en
# Vercel (Production): cópialo de ahí, no de este fichero.
#
# ⚠️ Este ejemplo traía escrito `https://auth.bivelio.com`, que es el proyecto de
# privacy y NO es al que apunta el despliegue de savings. Se deja vacío a
# propósito: un valor por defecto equivocado en un fichero de ejemplo manda al
# siguiente que clone esto contra la base de datos que no es.
#
# La URL y la anon key son PÚBLICAS (la anon es una publishable key; el acceso lo
# gobierna Row Level Security). La service-role SÍ es un secreto — solo servidor.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable anon key from the Supabase dashboard (Project Settings → API):
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, for privileged provisioning (licensing / metering / Stripe). Used by
# the admin Supabase client to bypass RLS on the control-plane tables (revocation
# ledger, seat_activity ingest). NEVER expose to the client, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Licensing (server-only secrets) ---------------------------------------
# Ed25519 PRIVATE signing key, base64 of the PEM. Signs licenses + the revocation
# list. The matching PUBLIC key is embedded in the SDK. Generate/keep offline.
LICENSE_PRIVATE_KEY_B64=

# Bearer token for the admin revoke endpoint (POST /api/license/revoke). Strong
# random secret; fail-closed if unset. Stripe webhooks will call revoke later.
LICENSE_ADMIN_TOKEN=

# Comma-separated emails allowed to self-issue a license (owner + pilots) via
# POST /api/license/trial, until Stripe checkout is live. Fail-closed if unset —
# nobody can mint. e.g. LICENSE_ISSUER_EMAILS=jmfisa@bivelio.com
LICENSE_ISSUER_EMAILS=

# --- Stripe (per-seat PRO billing) -----------------------------------------
# Server-only secrets. billingConfigured (and every /api/stripe/* route) fails
# closed (501) until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
# Webhook signing secret (Developers → Webhooks → your endpoint → signing secret).
STRIPE_WEBHOOK_SECRET=
# The two Price ids on the "BiVelio Savings Layer — Pro" product (Licensed /
# quantity-based): €4/seat/month and €39/seat/year — la modalidad CON comisión,
# CERRADA a clientes nuevos (2026-09-29): el checkout ya no la vende, pero hacen
# falta para reconocer y cobrar las suscripciones que la conservan. La moneda y el importe se
# LEEN del Price de Stripe en tiempo de ejecución (lib/stripe/pricing.ts); estos
# números son solo la referencia de qué Price hay que pegar aquí.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# LOS PLANES SIN COMISIÓN (lib/billing/planes.ts): los dos de arriba son la
# modalidad CON comisión; estos cuatro, Pro (por asiento) y Equipo («graduated»:
# N asientos incluidos por una cuota fija + asiento extra), en el MISMO producto.
# Los crea el dueño con scripts/provision-planes.mjs. Vacíos = el plan no se
# vende (el checkout da 501 para él) y /pricing pinta la cifra de respaldo.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_TEAM_MONTHLY=
STRIPE_PRICE_ID_TEAM_YEARLY=
# Publishable key (public). Not required for hosted Checkout (server redirects),
# but exposed for any future client-side Stripe.js usage.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Configuracion del PORTAL de facturacion, creada por scripts/provision-portal.mjs.
# Sin ella Stripe usa la configuracion por DEFECTO de la cuenta, donde
# `subscription_update` viene desactivado: un cliente que crece NO puede cambiar
# sus asientos, aunque el 409 del checkout le mande a "Gestionar plan". Ademas la
# nuestra fija la cancelacion a `at_period_end`, que no es una preferencia: con
# cancelacion inmediata, `handleSubDeleted` revoca las licencias al instante y a
# quien cancela el dia 5 le cortamos un mes que ya ha pagado.
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Crons (vercel.json) ----------------------------------------------------
# OBLIGATORIA para que el barrido de impago funcione. Vercel Cron manda
# `Authorization: Bearer $CRON_SECRET` en cada llamada, PERO SOLO SI la variable
# existe: sin ella el cron se sigue registrando y llamando, /api/cron/dunning
# responde 501 y no hace nada — es decir, las orgs pasadas de gracia conservan
# "pro" indefinidamente y el panel de crons de Vercel no lo delata. Fallo cerrado
# y silencioso: el peor de los dos, porque parece que funciona.
# Valor: cadena aleatoria larga (p. ej. `openssl rand -base64 32`).
CRON_SECRET=

# Donde se avisa cuando algo se rompe de verdad (Slack, Discord con /slack,
# Mattermost, un Zapier...). OPCIONAL pero muy recomendable: sin ella, las alertas
# solo van al registro con el prefijo `[bv-sala:ALERTA]` — y un registro en Vercel
# no despierta a nadie, que es justo el problema que esto viene a cerrar.
# Se avisa de: renovacion cobrada sin poder re-emitir licencia, cambio de
# suscripcion que no se ha aplicado, firma del webhook invalida (la tuberia entera
# muerta), perdida de datos de facturacion en el ingest, y organizaciones pagando
# sin licencia viva.
BVSALA_ALERT_WEBHOOK=

# Correo de las alertas CRITICAS (solo las criticas: mandar tambien los avisos
# entrena a ignorarlos y entonces se pierde el que importa). Se envia con la
# cuenta de Resend que la plataforma ya tiene —dominio bivelio.com verificado— y
# con `fetch` directo, sin SDK. Requiere RESEND_API_KEY.
# Por defecto support@bivelio.com. Admite varias separadas por comas.
BVSALA_ALERT_EMAIL=

# Clave de Resend, la MISMA cuenta que el resto de la plataforma (vive en el
# fichero de credenciales de GPOS): rotarla afecta tambien a GPOS.
RESEND_API_KEY=

# Días de gracia tras un impago, ANTES de degradar el plan. Opcional: por defecto
# 21, que cubre la ventana de Smart Retries de Stripe (~3 semanas). Ajústala si la
# configuración de reintentos de la cuenta es otra. Un valor inválido cae al de
# por defecto, nunca a algo más agresivo. Ver lib/billing/gracia.ts.
BVSALA_GRACE_DAYS=
